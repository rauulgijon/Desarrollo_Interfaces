<Window x:Class="MiniHito.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniHito"
        mc:Ignorable="d"
        Title="¿Aceptas el Reto?" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <TabControl SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="INICIO">
                
            </TabItem>
            <TabItem Header="ALUMNADO">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dataGridPersonas" Grid.Column="0" Margin="10" AutoGenerateColumns="False" 
                              SelectionChanged="dataGridPersonas_SelectionChanged" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Apellidos" Binding="{Binding Apellidos}" Width="*"/>
                            <DataGridTextColumn Header="Especialidad" Binding="{Binding Especialidad}" Width="80"/>
                            <DataGridTextColumn Header="Grupo" Binding="{Binding Grupo}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1" Margin="10">
                        <Label Content="Nombre:" FontWeight="Bold"/>
                        <TextBox x:Name="txtNombre" Margin="0,0,0,10"/>

                        <Label Content="Apellidos:" FontWeight="Bold"/>
                        <TextBox x:Name="txtApellido" Margin="0,0,0,10"/>

                        <Label Content="Especialidad:" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbCurso" Margin="0,0,0,20">
                            <ComboBoxItem Content="DAM" Tag="1"/>
                            <ComboBoxItem Content="DAW" Tag="2"/>
                            <ComboBoxItem Content="ASIR" Tag="3"/>
                        </ComboBox>

                        <Button x:Name="btnAgregar" Content="AGREGAR ALUMNO" Height="35" Margin="0,5" Click="btnAgregar_Click"/>
                        <Button x:Name="btnModificar" Content="MODIFICAR" Height="35" Margin="0,5" Click="btnModificar_Click" IsEnabled="False"/>
                        <Button x:Name="btnEliminar" Content="ELIMINAR" Height="35" Margin="0,5" Background="#FFFF9999" Click="btnEliminar_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="GRUPOS">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="White" HorizontalAlignment="Center">
                        <Label Content="Nombre del Grupo:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBox x:Name="txtNombreGrupo" Width="200" Margin="5,0"/>
                        <Button x:Name="btnGuardarGrupo" Content="Guardar / Crear" Width="120" Margin="5" Click="btnGuardarGrupo_Click"/>
                        <Button x:Name="btnEliminarGrupo" Content="Eliminar Grupo" Width="120" Margin="5" Background="#FFFF9999" Click="btnEliminarGrupo_Click"/>
                        <Button x:Name="btnLimpiarGrupo" Content="Limpiar" Width="80" Margin="5" Click="btnLimpiarGrupo_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <Label Content="Alumnos Libres" DockPanel.Dock="Top" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <ListBox x:Name="lstAlumnosSinGrupo" DisplayMemberPath="Nombre" Background="White"/>
                        </DockPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Button x:Name="btnMoverDerecha" Content="&gt;&gt;" Margin="0,5" Width="50" Click="btnMoverDerecha_Click"/>
                            <Button x:Name="btnMoverIzquierda" Content="&lt;&lt;" Margin="0,5" Width="50" Click="btnMoverIzquierda_Click"/>
                        </StackPanel>

                        <DockPanel Grid.Column="2">
                            <Label Content="Alumnos en el Grupo" DockPanel.Dock="Top" HorizontalAlignment="Center" FontWeight="Bold"/>
                            <ListBox x:Name="lstAlumnosEnGrupo" DisplayMemberPath="Nombre" Background="White"/>
                        </DockPanel>
                    </Grid>

                    <GroupBox Header="Grupos Existentes" Grid.Row="2" Height="150" Margin="10">
                        <ListBox x:Name="lstGrupos" SelectionChanged="lstGrupos_SelectionChanged" DisplayMemberPath="Nombre" Background="White"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="EMPRESAS">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dataGridEmpresa" Grid.Column="0" Margin="10" AutoGenerateColumns="False" 
                              SelectionChanged="dataGridEmpresa_SelectionChanged" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Razón Social" Binding="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1" Margin="10" Background="White">
                        <Label Content="DETALLE EMPRESA" FontWeight="Bold" HorizontalAlignment="Center" Margin="10" FontSize="16"/>

                        <StackPanel DataContext="{Binding ElementName=dataGridEmpresa, Path=SelectedItem}" Margin="10">
                            <Label Content="Razón Social:"/>
                            <TextBox x:Name="txtRazonSocial" Text="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                            <Label Content="Dirección:"/>
                            <TextBox x:Name="txtDireccion" Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                            <Label Content="Ciudad:"/>
                            <TextBox x:Name="txtCiudad" Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                            <Label Content="Teléfono:"/>
                            <TextBox x:Name="txtTelefono" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

                            <Label Content="Correo:"/>
                            <TextBox x:Name="txtCorreo" Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                        </StackPanel>

                        <Button x:Name="btnAgregarEmpresa" Content="NUEVA (Limpiar)" Margin="10,5" Click="btnAgregarEmpresa_Click"/>
                        <Button x:Name="btnModificarEmpresa" Content="GUARDAR CAMBIOS" Margin="10,5" Click="btnModificarEmpresa_Click"/>
                        <Button x:Name="btnEliminarEmpresa" Content="ELIMINAR" Background="#FFFF9999" Margin="10,5" Click="btnEliminarEmpresa_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="RETOS">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="dataGridReto" Grid.Column="0" Margin="10" AutoGenerateColumns="False" CanUserAddRows="False" 
                              SelectionChanged="dataGridReto_SelectionChanged" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat=d}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="1" Margin="10">
                        <Label Content="GESTIÓN DE RETOS" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" FontSize="16"/>

                        <Label Content="Nombre del Reto:"/>
                        <TextBox x:Name="txtRetoNombre" Margin="0,0,0,10"/>

                        <Label Content="Descripción:"/>
                        <TextBox x:Name="txtRetoDescripcion" Height="60" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Label Content="Fecha de Inicio:"/>
                        <DatePicker x:Name="dpFechaInicio" Margin="0,0,0,5" SelectedDateChanged="dpFechaInicio_SelectedDateChanged"/>

                        <TextBlock x:Name="lblInfoFestivo" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <CheckBox x:Name="chkRetoActivo" Content="¿Reto Activo?" Margin="0,10" FontWeight="Bold"/>

                        <Button x:Name="btnAgregarReto" Content="AGREGAR" Height="35" Margin="0,5" Click="btnAgregarReto_Click"/>
                        <Button x:Name="btnModificarReto" Content="MODIFICAR" Height="35" Margin="0,5" Click="btnModificarReto_Click"/>
                        <Button x:Name="btnEliminarReto" Content="ELIMINAR" Height="35" Margin="0,5" Background="#FFFF9999" Click="btnEliminarReto_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="TALENTLAB">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height ="1*"/>
                        <RowDefinition Height ="2*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="10">
                            <Label Content="Reto 1" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10">
                            <Label Content="Reto 2" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10">
                            <Label Content="Reto 3" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="dataGridTalentLab" Grid.Row="1" Grid.Column="0" Margin="10" AutoGenerateColumns="False" 
              SelectionChanged="dataGridPersonas_SelectionChanged" IsReadOnly="True" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Titulo" Binding="{Binding Titulo}" Width="100"/>
                            <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
                        <Label Content="Título:" FontWeight="Bold"/>
                        <TextBox x:Name="txtTitulo" Margin="0,0,0,10"/>

                        <Label Content="Descripcion:" FontWeight="Bold"/>
                        <TextBox x:Name="txtDescripcion" Margin="0,0,0,10"/>

                        

                        <Button x:Name="btnAgregarTalentLab" Content="AGREGAR TALENT LAB" Height="35" Margin="0,5" Click="btnAgregar_Click"/>
                        <Button x:Name="btnModificarTalentLab" Content="MODIFICAR" Height="35" Margin="0,5" Click="btnModificar_Click" IsEnabled="False"/>
                        <Button x:Name="btnEliminarTalentLab" Content="ELIMINAR" Height="35" Margin="0,5" Background="#FFFF9999" Click="btnEliminar_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="USUARIOS">
                
            </TabItem>

        </TabControl>
    </Grid>
</Window>