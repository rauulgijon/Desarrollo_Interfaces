<Window x:Class="ApiJsonTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lector de JSON Local" Height="450" Width="800">
    <StackPanel Margin="10">
        <Button Name="BtnLoad" Content="Cargar archivo JSON" Click="BtnLoad_Click" Padding="5" Margin="0,0,0,10"/>

        <DataGrid Name="DataGridItems" AutoGenerateColumns="True" Height="300" IsReadOnly="True"/>

        <TextBlock Name="TxtStatus" Text="Esperando..." Foreground="Gray" Margin="0,10,0,0"/>
    </StackPanel>
</Window>