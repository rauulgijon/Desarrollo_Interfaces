<Window x:Class="ApiUrlTemplate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ApiUrlTemplate"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <Button Name="BtnLoad" Content="Cargar desde API" Click="BtnLoad_Click" Padding="5" Margin="0,0,0,10"/>
            <DataGrid Name="DataGridItems" AutoGenerateColumns="True" Height="300"/>
            <TextBlock Name="TxtStatus" Text="Esperando..." Foreground="Gray" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
